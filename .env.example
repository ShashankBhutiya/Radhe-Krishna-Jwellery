# Postgres connection string (Neon, Supabase, or any hosted Postgres).
# Neon/Supabase poolers need ?sslmode=require and often ?pgbouncer=true
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Long random string used to sign session cookies.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me"

# Optional: credentials the seed script creates for the store admin.
ADMIN_EMAIL="admin@radhekrishna.in"
ADMIN_PASSWORD="change-me"
DEMO_PASSWORD="demo1234"

# Razorpay Payment Gateway Credentials
# Generate these in Razorpay Dashboard -> Settings -> API Keys (Test mode or Live mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Optional: Webhook secret configured in Razorpay Dashboard -> Settings -> Webhooks for /api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=""

# Optional: Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
